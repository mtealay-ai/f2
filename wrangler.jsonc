{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "f2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7adef73b-3d3a-4308-8e7e-18142417c34c","database_name": "f2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6a792cff7de84ffd968814eed2db1929" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
